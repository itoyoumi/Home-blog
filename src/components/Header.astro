---
// 全站顶栏：logo + 导航 + 实时时钟
const siteName = "MRDENG"; // ← 改成你的站点名

const nav = [
    { href: "/", label: "首页" },
    { href: "/nav", label: "导航" },
    { href: "/about", label: "关于" }, // about 页还没建，不想留空链就删掉这行
];

const current = Astro.url.pathname;
const isActive = (href: string) =>
    href === "/" ? current === "/" : current.startsWith(href);
---

<header
    id="top"
    class="sticky top-0 z-40 border-b-2 border-ink bg-paper/95 backdrop-blur-sm"
>
    <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 sm:px-6">
        <a href="/" class="group flex items-center gap-2.5">
            <!-- 方块 logo，悬停歪一下 -->
            <span
                class="grid h-8 w-8 place-items-center border-2 border-ink bg-accent font-display text-sm font-bold text-white shadow-[3px_3px_0_0_var(--color-ink)] transition-transform duration-200 group-hover:-rotate-6"
            >
                登
            </span>
            <span class="font-display text-lg font-bold tracking-tight"
                >{siteName}<span class="text-accent">.</span></span
            >
        </a>

        <nav class="ml-auto flex items-center gap-1 sm:gap-1.5">
            {
                nav.map((item) => (
                    <a
                        href={item.href}
                        class:list={[
                            "px-2.5 py-1.5 font-mono text-sm transition-all duration-150 sm:px-3",
                            isActive(item.href)
                                ? "bg-ink text-paper"
                                : "text-ink/60 hover:bg-ink/5 hover:text-ink",
                        ]}
                    >
                        {item.label}
                    </a>
                ))
            }
        </nav>

        <!-- 实时时钟，由 BaseLayout 脚本驱动 -->
        <span
            data-clock
            class="hidden font-mono text-xs tabular-nums text-ink/40 lg:inline"
            >--:--:--</span
        >
    </div>
</header>
