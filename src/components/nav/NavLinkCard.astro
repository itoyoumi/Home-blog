---
// 单张卡片：favicon（首字母兜底）+ 标题描述 + 域名
import { faviconOf, type NavLink } from "../../data/nav";

interface Props {
    link: NavLink;
    index: number; // 渐显错峰
}
const { link, index } = Astro.props;
const host = new URL(link.url).hostname;
---

<li class="reveal" style={`--i: ${Math.min(index, 5)}`}>
    <a
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex h-full flex-col border border-ink/15 bg-paper p-4 transition-all duration-200 hover:-translate-y-1 hover:border-ink hover:shadow-[5px_5px_0_0_var(--color-accent)]"
    >
        <div class="flex items-start justify-between">
            <span
                class="relative grid h-10 w-10 place-items-center border border-ink/15 bg-white font-display text-sm font-bold text-accent transition-transform duration-200 group-hover:-rotate-3 group-hover:scale-105"
            >
                {link.title.charAt(0)}
                <img
                    src={faviconOf(link.url)}
                    alt=""
                    width="40"
                    height="40"
                    loading="lazy"
                    onerror="this.remove()"
                    class="absolute inset-0 h-full w-full bg-white object-contain p-1.5"
                />
            </span>
            <span
                class="text-ink/25 transition-all duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
                >↗</span
            >
        </div>

        <h3
            class="mt-3 font-display leading-snug font-bold transition-colors group-hover:text-accent"
        >
            {link.title}
        </h3>
        {
            link.desc && (
                <p class="mt-1 line-clamp-2 text-sm text-ink/55">{link.desc}</p>
            )
        }

        <p
            class="mt-auto flex items-center gap-1.5 pt-3 font-mono text-[11px] text-ink/35"
        >
            <span
                class="h-1 w-1 bg-ink/25 transition-colors group-hover:bg-accent"
            ></span>
            {host}
        </p>
    </a>
</li>
