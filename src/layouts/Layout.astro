---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
    description?: string;
    wide?: boolean;
}
const { title, description, wide = false } = Astro.props;
---

<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        {description && <meta name="description" content={description} />}
        <title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=JetBrains+Mono:wght@400;700&family=Noto+Sans+SC:wght@400;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="min-h-screen bg-paper font-body text-ink antialiased">
        <Header />
        <main
            class:list={[
                "mx-auto px-4 sm:px-6",
                wide ? "max-w-6xl" : "max-w-3xl",
            ]}
        >
            <slot />
        </main>
        <Footer />

        <script>
            const $$ = <T extends HTMLElement>(s: string) =>
                Array.from(document.querySelectorAll<T>(s));
            const reduceMotion = matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;

            /* 滚动渐显 */
            if (!reduceMotion) {
                const rio = new IntersectionObserver(
                    (entries) => {
                        for (const en of entries) {
                            if (en.isIntersecting) {
                                en.target.classList.add("is-revealed");
                                rio.unobserve(en.target);
                            }
                        }
                    },
                    { threshold: 0.08, rootMargin: "0px 0px -5% 0px" },
                );
                $$(".reveal").forEach((el) => {
                    el.classList.add("pre-reveal");
                    rio.observe(el);
                });
            }

            /* 实时时钟 */
            const clocks = $$("[data-clock]");
            if (clocks.length) {
                const fmtTime = new Intl.DateTimeFormat("zh-CN", {
                    hour12: false,
                    hour: "2-digit",
                    minute: "2-digit",
                    second: "2-digit",
                });
                const fmtDate = new Intl.DateTimeFormat("zh-CN", {
                    year: "numeric",
                    month: "2-digit",
                    day: "2-digit",
                    weekday: "short",
                });
                const tick = () => {
                    const now = new Date();
                    clocks.forEach((el) => {
                        el.textContent =
                            el.dataset.clock === "date"
                                ? fmtDate.format(now)
                                : fmtTime.format(now);
                    });
                };
                tick();
                setInterval(tick, 1000);
            }
        </script>

        <style is:global>
            .pre-reveal {
                opacity: 0;
                transform: translateY(14px);
                transition:
                    opacity 0.55s ease,
                    transform 0.55s ease;
                transition-delay: calc(var(--i, 0) * 45ms);
            }
            .pre-reveal.is-revealed {
                opacity: 1;
                transform: none;
            }
        </style>
    </body>
</html>
